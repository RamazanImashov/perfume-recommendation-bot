BOT_TOKEN=your_telegram_bot_token
OWNER_ID=123456789
APP_ENV=development
PUBLIC_URL=https://your-project.vercel.app
WEBHOOK_SECRET=change_me

# Optional persistent serverless Redis/Upstash REST. Bot works without it,
# but Vercel FSM persistence, feedback/history, last location and preferences are disabled/unreliable without it.
REDIS_REST_URL=
REDIS_REST_TOKEN=
FSM_TTL_SECONDS=86400
# Aliases UPSTASH_REDIS_REST_URL/TOKEN and KV_REST_API_URL/TOKEN are also accepted.

# Optional OpenAI-compatible parser/reranker. Deterministic engine works without AI.
AI_ENABLED=false
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=
